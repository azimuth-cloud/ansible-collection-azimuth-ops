---
apiVersion: source.toolkit.fluxcd.io/v1
kind: OCIRepository
metadata:
  name: capi-management-cluster
  namespace: azimuth
spec:
  interval: 5m0s
  url: oci://ghcr.io/azimuth-cloud/azimuth-config/stack-hpc/capi-management-cluster
  ref:
    tag: ${FLUX_ARTIFACT_TAG}
---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: capi-management-cluster
  namespace: flux-system
spec:
  interval: 10m
  targetNamespace: azimuth
  sourceRef:
    kind: OCIRepository
    name: capi-management-cluster
    namespace: azimuth
  path: "./"
  prune: true
  timeout: 3m
  postBuild:
    substituteFrom:
      - kind: ConfigMap
        name: dynamic-azimuth-info
      - kind: ConfigMap
        name: static-azimuth-info
        optional: true
      - kind: ConfigMap
        name: capi-cluster-info
